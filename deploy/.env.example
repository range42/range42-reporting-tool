# --- required (no defaults; boot fails without them) ---
DATABASE_URL=postgresql+asyncpg://reporting:changeme@postgres:5432/reporting
JWT_SECRET=replace-with-a-32+char-random-string-now

# --- storage (design override: local default) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/attachments

# --- deploy ---
TLS_MODE=acme
RUN_MIGRATIONS_ON_START=false
CORS_ORIGINS=http://localhost:5173
APP_VERSION=0.1.0

# --- identity / OIDC (blank issuer => health reports oidc 'disabled') ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=

# --- emergency local admin (recovery backstop; disabled by default) ---
# Generate the hash with: python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
EMERGENCY_ADMIN_ENABLED=false
EMERGENCY_ADMIN_PASSWORD_HASH=

# --- auth / session ---
JWT_ACCESS_TTL_MINUTES=60
JWT_EXERCISE_MAX_SESSION_HOURS=24

# --- branding (runtime, served via /api/v1/config) ---
BRANDING_APP_NAME=Reporting Tool
BRANDING_LOGO_URL=
BRANDING_PRIMARY_COLOR=#2563eb
